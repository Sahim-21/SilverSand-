# Database (Neon Postgres)
DATABASE_URL=

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=

# Owner admin (seed script only — not used at runtime except seed)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public site URL (canonical, OG, sitemap). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://silversandhomestay.com

# Google Places API (New) — server-side only. Never prefix with NEXT_PUBLIC_.
# Place Details field mask: reviews only. Cache is 24h in getGoogleReviews().
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Optional: set to "true" on Vercel Preview to block admin routes
# DISABLE_ADMIN_ON_PREVIEW=true
